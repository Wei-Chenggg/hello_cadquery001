\f2 \cf2 \strokec2 class Hardware_Controller:\
    def __init__(self, port_name):\
        self.ser = serial.Serial(port_name, 9600, timeout=1)\
    def write_dac_voltage(self, dac_value):\
        high_byte = (dac_value >> 8) & 0x0F\
        low_byte = dac_value & 0xFF\
        cmd = bytes([0x53, 0xC0, 0x02, high_byte, low_byte, 0x50])\
        self.ser.write(cmd)\
    def read_adc_voltage(self):\
        cmd = bytes([0x53, 0x9B, 0x02, 0x50])\
        self.ser.write(cmd)\
        response = self.ser.read(2)\
        if len(response) == 2:\
            adc_value = ((response[0] & 0x0F) << 8) | response[1]\
            return (adc_value / 4095.0) * 3.3\
        return -1\
    def init_gpio_direction(self):\
        cmd = bytes([0x53, 0x40, 0x03, 0x00, 0x00, 0x00, 0x50])\
        self.ser.write(cmd)\
    def set_gpio_state(self, state_a, state_b):\
        cmd = bytes([0x53, 0x40, 0x03, 0x12, state_a, state_b, 0x50])\
        self.ser.write(cmd)\
\pard\pardeftab720\sa298\partightenfactor0

